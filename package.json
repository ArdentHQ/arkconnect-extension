        "@ledgerhq/hw-transport-webusb": "^6.35.0",
        "@mainsail/evm-contracts": "0.0.1-evm.18",
        "@reduxjs/toolkit": "^2.15.0",
        "@sentry/react": "^11.19.0",
        "@tippyjs/react": "^4.2.6",
        "@types/file-saver": "^2.0.7",
        "assert": "2.1.0",
        "big.js": "^7.0.1",
        "classnames": "^2.5.1",
        "color-thief-react": "^2.1.0",
        "crypto-js": "^4.2.0",
        "dayjs": "^1.11.23",
        "dinero.js": "^2.0.2",
        "dot-prop": "^10.2.0",
        "fast-copy": "^4.3.4",
        "fast-deep-equal": "^3.1.3",
        "file-saver": "^2.0.5",
        "focus-trap-react": "^12.0.4",
        "formik": "^2.4.9",
        "html-to-image": "^1.11.13",
        "i18next": "^27.2.10",
        "joi": "^18.3.2",
        "jsqr": "^1.4.0",
        "locale-currency": "^1.1.0",
