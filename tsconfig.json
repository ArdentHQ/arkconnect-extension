{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "useUnknownInCatchVariables": false,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "types": ["vitest/globals"],
        "noImplicitAny": false,
        "paths": {
            "@/app/*": ["./src/*"],
            "@/*": ["./src/*"]
        }
    },
    "exclude": [
        "**/tests/**",
        "src/tests/**/*",
        "src/lib/contexts/**/*",
        "src/lib/domains/**/*",
        "src/lib/services/ToastService.tsx",
        "src/lib/hooks/use-previous.ts",
        "src/lib/hooks/use-profile-synchronizer.ts",
        "src/lib/hooks/use-synchronizer.ts",
        "src/lib/hooks/use-theme.ts",
        "src/utils/testing-library.tsx",
        "src/utils/test-helpers.ts",
        "src/utils/test-plugins.ts",
        "src/utils/server-utils.ts",
        "src/utils/ledger-test-helpers.ts",
        "src/utils/profile-utils.ts",
        "src/utils/profile-peers.ts",
        "src/utils/peers.ts",
        "src/utils/network-utils.ts",
        "src/utils/url-validation.ts",
        "dist/**/*"
    ],
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
